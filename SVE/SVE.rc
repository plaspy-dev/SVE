#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0c0a04e4"
        BEGIN
            VALUE "CompanyName", "SDG"
            VALUE "FileDescription", "Sistema de verificación de envios"
            VALUE "FileVersion", "2.1.0.1"
            VALUE "InternalName", "SVE.exe"
            VALUE "LegalCopyright", "SDG(c).  Reservados todos los derechos."
            VALUE "OriginalFilename", "SVE.exe"
            VALUE "ProductName", "SVE (Sistema de verificación de envios)"
            VALUE "ProductVersion", "2.1.0.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0xc0a, 1252
    END
END


