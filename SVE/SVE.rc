/////////////////////////////////////////////////////////////////////////////
//
// Icon
//

// Icon with lowest ID value placed first to ensure application icon
// remains consistent on all systems.
IDR_MAINFRAME           ICON                    "res\\SVE.ico"
IDR_SVETYPE             ICON                    "res\\SVEDoc.ico"

/////////////////////////////////////////////////////////////////////////////
//
// Bitmap
//

IDR_MAINFRAME           BITMAP                  "res\\Toolbar.bmp"

/////////////////////////////////////////////////////////////////////////////
//
// Toolbar
//

IDR_MAINFRAME TOOLBAR  16, 15
BEGIN
    BUTTON      ID_FILE_NEW
    BUTTON      ID_FILE_OPEN
    BUTTON      ID_FILE_SAVE
    SEPARATOR
    BUTTON      ID_EDIT_CUT
    BUTTON      ID_EDIT_COPY
    BUTTON      ID_EDIT_PASTE
    SEPARATOR
    BUTTON      ID_FILE_PRINT
    BUTTON      ID_APP_ABOUT
END


/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
        MENUITEM "&Propiedades\tF3",            ID_VER_PROPIEDADES
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 ID_CONFIGURACION_SERVIDORES
        MENUITEM "&Personalizar",               ID_HERRAMIENTAS_PERSONALIZAR
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "A&yuda\tF1",                  ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&Indice\tCtrl+F1",            ID_HELP_INDEX
        MENUITEM "&Buscar\tAlt+F1",             ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de SVE...",           ID_APP_ABOUT
    END
END

IDR_SVETYPE MENU 
BEGIN
    POPUP "&Archivo"
    BEGIN
        MENUITEM "&Nuevo\tCtrl+N",              ID_FILE_NEW
        MENUITEM "&Cerrar",                     ID_FILE_CLOSE
        MENUITEM "&Guardar\tCtrl+G",            ID_FILE_SAVE
        MENUITEM SEPARATOR
        MENUITEM "&Imprimir\tCtrl+P",           57607
        MENUITEM "&Vista Preliminar",           57609
        MENUITEM "C&onfigurar Página",          57606
        MENUITEM SEPARATOR
        MENUITEM "&Salir",                      ID_APP_EXIT
    END
    POPUP "&Edición"
    BEGIN
        MENUITEM "&Deshacer\tCtrl+Z",           ID_EDIT_UNDO
        MENUITEM SEPARATOR
        MENUITEM "Cor&tar\tCtrl+X",             ID_EDIT_CUT
        MENUITEM "&Copiar\tCtrl+C",             ID_EDIT_COPY
        MENUITEM "&Pegar\tCtrl+V",              ID_EDIT_PASTE
    END
    POPUP "&Ver"
    BEGIN
        MENUITEM "&Barra de herramientas",      ID_VIEW_TOOLBAR
        MENUITEM "&Barra de estado",            ID_VIEW_STATUS_BAR
        MENUITEM SEPARATOR
        MENUITEM "&Navegador\tF2",              136
        MENUITEM "&Propiedades\tF3",            ID_VER_PROPIEDADES
    END
    POPUP "&Herramientas"
    BEGIN
        MENUITEM "&Servidores",                 142
        MENUITEM "&Personalizar",               ID_HERRAMIENTAS_PERSONALIZAR
    END
    POPUP "&Ventana"
    BEGIN
        MENUITEM "&Cascada",                    ID_WINDOW_CASCADE
        MENUITEM "&Mosaico",                    ID_WINDOW_TILE_HORZ
    END
    POPUP "Ay&uda"
    BEGIN
        MENUITEM "A&yuda\tF1",                  ID_HELP
        MENUITEM SEPARATOR
        MENUITEM "&Indice\tCtrl+F1",            ID_HELP_INDEX
        MENUITEM "&Buscar\tAlt+F1",             ID_HELP_FINDER
        MENUITEM SEPARATOR
        MENUITEM "&Acerca de SVE...",           ID_APP_ABOUT
    END
END


/////////////////////////////////////////////////////////////////////////////
//
// Accelerator
//

IDR_MAINFRAME ACCELERATORS 
BEGIN
    VK_F2,          136,                    VIRTKEY, NOINVERT
    VK_F1,          ID_HELP,                VIRTKEY, NOINVERT
    VK_F1,          ID_HELP_FINDER,         VIRTKEY, ALT, NOINVERT
    VK_F1,          ID_HELP_INDEX,          VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_B_AGREGAR,           VIRTKEY, NOINVERT
    "C",            ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_COPY,           VIRTKEY, CONTROL, NOINVERT
    VK_DELETE,      ID_EDIT_CUT,            VIRTKEY, SHIFT, NOINVERT
    "X",            ID_EDIT_CUT,            VIRTKEY, CONTROL, NOINVERT
    "V",            ID_EDIT_PASTE,          VIRTKEY, CONTROL, NOINVERT
    VK_INSERT,      ID_EDIT_PASTE,          VIRTKEY, SHIFT, NOINVERT
    VK_BACK,        ID_EDIT_UNDO,           VIRTKEY, ALT, NOINVERT
    "Z",            ID_EDIT_UNDO,           VIRTKEY, CONTROL, NOINVERT
    "N",            ID_FILE_NEW,            VIRTKEY, CONTROL, NOINVERT
    "O",            ID_FILE_OPEN,           VIRTKEY, CONTROL, NOINVERT
    "G",            ID_FILE_SAVE,           VIRTKEY, CONTROL, NOINVERT
    VK_F6,          ID_NEXT_PANE,           VIRTKEY, NOINVERT
    VK_F6,          ID_PREV_PANE,           VIRTKEY, SHIFT, NOINVERT
    VK_F3,          ID_VER_PROPIEDADES,     VIRTKEY, NOINVERT
    "P",            57607,                  VIRTKEY, CONTROL, NOINVERT
    VK_RIGHT,       ID_NEXT_PANEEX,         VIRTKEY, ALT, NOINVERT
    VK_LEFT,        ID_PREV_PANEEX,         VIRTKEY, ALT, NOINVERT
    VK_PRIOR,       ID_PREV_PANEEX,         VIRTKEY, CONTROL, NOINVERT
    VK_NEXT,        ID_NEXT_PANEEX,         VIRTKEY, CONTROL, NOINVERT
END


